# LeaseKey runs on NEAR TESTNET only. Nothing here is secret by default.

# Live deployment (also committed in web/src/deployment.json, which the app reads by default)
VITE_FACTORY_ID=leasekey-i67g6n.testnet
VITE_RPC_URL=https://test.rpc.fastnear.com

# Scripts (deploy / keeper / e2e)
NEAR_RPC_URL=https://test.rpc.fastnear.com
# FACTORY_ID=leasekey-i67g6n.testnet   # keeper: watch another deployment
# MODE=global                          # deploy: global | embedded
# ITEMS=5                              # deploy: number of demo items (1..6)

# Optional: run the keeper with your own TESTNET account instead of a faucet one
# KEEPER_ACCOUNT_ID=your-keeper.testnet
# KEEPER_PRIVATE_KEY=ed25519:...
